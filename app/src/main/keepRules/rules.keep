# R8 keep rules. AGP combines every file in src/main/keepRules.

# JSch picks its crypto implementations by class name at runtime
# (see SshCrypto.install), so R8 can't see they're used.
-keep class com.jcraft.jsch.** { *; }
-dontwarn com.jcraft.jsch.**

# Bouncy Castle classes are reached from those JSch modules.
-keep class org.bouncycastle.** { *; }
-dontwarn org.bouncycastle.**

# JNI looks up native methods by class and method name (traceroute.c).
-keepclasseswithmembernames class * {
    native <methods>;
}
